# Local issue scratchpad
.scratch/issues/*.md
!.scratch/issues/.gitkeep
.scratch/captures/

# Work-log captures are personal source material, not part of this skills repo.
obsidian_log_formatter/

# Generated task artifacts and media outputs are local delivery files.
outputs/

# Local Claude/Codex state
.claude/settings.local.json
CLAUDE.local.md
.codex/

# Secrets
.env
.env.*
*.pem
*.key
*.p12

# Tooling crash noise. Git Bash drops bash.exe.stackdump wherever a worker fork
# dies (vitest on Windows does this reliably); Chromium-based tools drop debug.log.
bash.exe.stackdump
debug.log

# OS/editor noise
.DS_Store
.idea/
.vscode/

# Python
__pycache__/
*.pyc
